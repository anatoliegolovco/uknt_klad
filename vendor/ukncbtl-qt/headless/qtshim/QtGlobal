// Headless Qt shim — provides only the integer typedefs emubase needs, no Qt.
#pragma once
#include <stdint.h>
typedef uint8_t  quint8;   typedef int8_t  qint8;
typedef uint16_t quint16;  typedef int16_t qint16;
typedef uint32_t quint32;  typedef int32_t qint32;
typedef uint64_t quint64;  typedef int64_t qint64;
typedef unsigned int   uint;    typedef unsigned short ushort;
typedef unsigned char  uchar;   typedef unsigned long  ulong;
#ifndef Q_UNUSED
#define Q_UNUSED(x) (void)(x);
#endif
